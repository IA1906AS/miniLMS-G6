# Sao chép sang .env và đặt secret thật. KHÔNG commit .env.
JWT_SECRET=thay-bang-secret-it-nhat-32-ky-tu
TOKEN_TTL_SECONDS=900
AUDIT_LOG_PATH=audit.log

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=minilms_g6
DB_USER=postgres
DB_PASSWORD=postgres

# Retry khi tạo pool / lấy connection: exponential backoff + full jitter.
# Tổng số lần thử, trần delay lần đầu (ms), trần delay tối đa (ms).
DB_RETRY_ATTEMPTS=4
DB_RETRY_BASE_DELAY_MS=100
DB_RETRY_MAX_DELAY_MS=2000
